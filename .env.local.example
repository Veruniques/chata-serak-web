# URL na WordPress backend (bez lomítka na konci)
# Doporučeno: přesunout WP na subdoménu, např. admin.chatanaseraku.cz,
# a novou frontend doménu (chatanaseraku.cz) nechat čistě pro Next.js/Vercel.
WORDPRESS_API_URL=https://admin.chatanaseraku.cz

# API klíč pro AI chat widget (viz console.anthropic.com -> Settings -> API Keys)
# Bez něj widget zůstane funkční, jen bude vždy odkazovat na e-mail.
ANTHROPIC_API_KEY=sk-ant-...

# Google Analytics 4 — měřicí ID ve tvaru G-XXXXXXXXXX
# (analytics.google.com -> Správce -> Datové streamy -> webový stream).
# Bez něj se měření ani lišta se souhlasem nezobrazí.
NEXT_PUBLIC_GA_ID=

# Kam chodí poptávky z formulářů (výchozí: info@chatanaseraku.cz)
INQUIRY_TO=info@chatanaseraku.cz
